{
  "Create Custom Service Test": {
    "prefix": "nest-service-test",
    "body": [
      "import { Test, TestingModule } from '@nestjs/testing';",
      "import { ${1:CustomName}Service } from './${1:custom-name}.service';",
      "import { ${1:CustomName}Repository } from '@src/database/repositories';",
      "import { ${1:CustomName}Dto } from '../../dto';",
      "import { ${1:CustomName}Mapper } from '../../mappers';",
      "import { ${1:CustomName}Document } from '@src/database/schemas';",
      "import { Types } from 'mongoose';",
      "",
      "const mock${1:CustomName}Document: Partial<${1:CustomName}Document> = {",
      "  _id: new Types.ObjectId(),",
      "  value: 'value',",
      "  id: '1',",
      "};",
      "",
      "const mock${1:CustomName}Repository = () => ({",
      "  create: jest.fn().mockResolvedValue(mock${1:CustomName}Document),",
      "  findAll: jest.fn().mockResolvedValue([mock${1:CustomName}Document]),",
      "  findById: jest.fn().mockResolvedValue(mock${1:CustomName}Document),",
      "  updateById: jest.fn().mockResolvedValue(mock${1:CustomName}Document),",
      "  removeById: jest.fn().mockResolvedValue(mock${1:CustomName}Document),",
      "});",
      "",
      "type MockRepository<T = any> = {",
      "  [P in keyof T]: jest.Mock<any, any>;",
      "};",
      "",
      "describe('${1:CustomName}Service', () => {",
      "  let service: ${1:CustomName}Service;",
      "  let repository: MockRepository<${1:CustomName}Repository>;",
      "",
      "  beforeEach(async () => {",
      "    const module: TestingModule = await Test.createTestingModule({",
      "      providers: [",
      "        ${1:CustomName}Service,",
      "        {",
      "          provide: ${1:CustomName}Repository,",
      "          useFactory: mock${1:CustomName}Repository,",
      "        },",
      "      ],",
      "    }).compile();",
      "",
      "    service = module.get<${1:CustomName}Service>(${1:CustomName}Service);",
      "    repository = module.get<${1:CustomName}Repository, MockRepository<${1:CustomName}Repository>>(${1:CustomName}Repository);",
      "  });",
      "",
      "  it('should be defined', () => {",
      "    expect(service).toBeDefined();",
      "  });",
      "",
      "  describe('create', () => {",
      "    it('should create a new ${1:customName}', async () => {",
      "      const dto: ${1:CustomName}Dto = { value: 'value' };",
      "      const result = await service.create(dto);",
      "      expect(result).toEqual(${1:CustomName}Mapper.mapDocument(mock${1:CustomName}Document as ${1:CustomName}Document));",
      "      expect(repository.create).toHaveBeenCalledWith(dto);",
      "    });",
      "  });",
      "",
      "  describe('findAll', () => {",
      "    it('should return an array of ${1:customNames}', async () => {",
      "      const result = await service.findAll();",
      "      expect(result).toEqual(${1:CustomName}Mapper.mapCollection([mock${1:CustomName}Document as ${1:CustomName}Document]));",
      "      expect(repository.findAll).toHaveBeenCalled();",
      "    });",
      "  });",
      "",
      "  describe('findById', () => {",
      "    it('should return a ${1:customName} by ID', async () => {",
      "      const result = await service.findById('1');",
      "      expect(result).toEqual(${1:CustomName}Mapper.mapDocument(mock${1:CustomName}Document as ${1:CustomName}Document));",
      "      expect(repository.findById).toHaveBeenCalledWith('1');",
      "    });",
      "  });",
      "",
      "  describe('updateById', () => {",
      "    it('should update a ${1:customName} by ID', async () => {",
      "      const updateData: Partial<${1:CustomName}Dto> = { value: 'value' };",
      "      const result = await service.updateById('1', updateData);",
      "      expect(result).toEqual(${1:CustomName}Mapper.mapDocument({ ...mock${1:CustomName}Document, ...updateData } as ${1:CustomName}Document));",
      "      expect(repository.updateById).toHaveBeenCalledWith('1', updateData);",
      "    });",
      "  });",
      "",
      "  describe('removeById', () => {",
      "    it('should remove a ${1:customName} by ID', async () => {",
      "      const result = await service.removeById('1');",
      "      expect(result).toEqual(${1:CustomName}Mapper.mapDocument(mock${1:CustomName}Document as ${1:CustomName}Document));",
      "      expect(repository.removeById).toHaveBeenCalledWith('1');",
      "    });",
      "  });",
      "});",
    ],
    "description": "Create a customizable NestJS service test",
  },
}

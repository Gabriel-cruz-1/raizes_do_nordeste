{
  "Create Custom Controller": {
    "prefix": "nestjs-controller",
    "body": [
      "import { Body, Controller, Delete, Get, HttpCode, HttpStatus, Param, Post, Put } from '@nestjs/common';",
      "import { ApiBearerAuth, ApiOperation, ApiResponse, ApiTags } from '@nestjs/swagger';",
      "import { ${1:CustomName}Service } from '../../services';",
      "import { ${1:CustomName}Dto } from '../../dto';",
      "import { ${1:CustomName}Response } from '../../responses';",
      "import { withBaseCollectionResponse, withBaseDataResponse, withErrorResponse } from '@src/common/utils';",
      "import { ParseObjectIdPipe } from '@src/common/pipes';",
      "",
      "@ApiTags('${1:CustomName}')",
      "@Controller('${1:custom-name}')",
      "export class ${1:CustomName}Controller {",
      "  constructor(private readonly ${1:camelCase}Service: ${1:CustomName}Service) {}",
      "",
      "  @HttpCode(HttpStatus.CREATED)",
      "  @ApiOperation({ summary: 'Create ${1:CustomName}' })",
      "  @ApiResponse({",
      "    type: withBaseDataResponse(${1:CustomName}Response),",
      "    status: HttpStatus.CREATED,",
      "    description: 'Create a ${1:CustomName}',",
      "  })",
      "  @ApiResponse({",
      "    type: withErrorResponse({ status: HttpStatus.BAD_REQUEST, title: 'BAD_REQUEST' }),",
      "    status: HttpStatus.BAD_REQUEST,",
      "    description: 'When request isn’t correct',",
      "  })",
      "  @ApiBearerAuth('access-token')",
      "  @Post()",
      "  async create(@Body() create${1:CustomName}Dto: ${1:CustomName}Dto): Promise<{ data: ${1:CustomName}Response }> {",
      "    const data = await this.${1:camelCase}Service.create(create${1:CustomName}Dto);",
      "    return { data };",
      "  }",
      "",
      "  @HttpCode(HttpStatus.OK)",
      "  @ApiOperation({ summary: 'Get all ${1:CustomNames}' })",
      "  @ApiResponse({",
      "    type: withBaseCollectionResponse(${1:CustomName}Response),",
      "    status: HttpStatus.OK,",
      "    description: 'Get all ${1:CustomNames}',",
      "  })",
      "  @ApiResponse({",
      "    type: withErrorResponse({ status: HttpStatus.BAD_REQUEST, title: 'BAD_REQUEST' }),",
      "    status: HttpStatus.BAD_REQUEST,",
      "    description: 'When request isn’t correct',",
      "  })",
      "  @ApiBearerAuth('access-token')",
      "  @Get()",
      "  async findAll(): Promise<{ data: ${1:CustomName}Response[] }> {",
      "    const data = await this.${1:camelCase}Service.findAll();",
      "    return { data };",
      "  }",
      "",
      "  @HttpCode(HttpStatus.OK)",
      "  @ApiOperation({ summary: 'Get a ${1:CustomName} by ID' })",
      "  @ApiResponse({",
      "    type: withBaseDataResponse(${1:CustomName}Response),",
      "    status: HttpStatus.OK,",
      "    description: 'Get a ${1:CustomName} by ID',",
      "  })",
      "  @ApiResponse({",
      "    type: withErrorResponse({ status: HttpStatus.BAD_REQUEST, title: 'BAD_REQUEST' }),",
      "    status: HttpStatus.BAD_REQUEST,",
      "    description: 'When request isn’t correct',",
      "  })",
      "  @ApiBearerAuth('access-token')",
      "  @Get(':id')",
      "  async findById(@Param('id', ParseObjectIdPipe) id: string): Promise<{ data: ${1:CustomName}Response }> {",
      "    const data = await this.${1:camelCase}Service.findById(id);",
      "    return { data };",
      "  }",
      "",
      "  @HttpCode(HttpStatus.OK)",
      "  @ApiOperation({ summary: 'Update a ${1:CustomName} by ID' })",
      "  @ApiResponse({",
      "    type: withBaseDataResponse(${1:CustomName}Response),",
      "    status: HttpStatus.OK,",
      "    description: 'Update a ${1:CustomName} by ID',",
      "  })",
      "  @ApiResponse({",
      "    type: withErrorResponse({ status: HttpStatus.BAD_REQUEST, title: 'BAD_REQUEST' }),",
      "    status: HttpStatus.BAD_REQUEST,",
      "    description: 'When request isn’t correct',",
      "  })",
      "  @ApiBearerAuth('access-token')",
      "  @Put(':id')",
      "  async updateById(@Param('id', ParseObjectIdPipe) id: string, @Body() updateData: Partial<${1:CustomName}Dto>): Promise<{ data: ${1:CustomName}Response }> {",
      "    const data = await this.${1:camelCase}Service.updateById(id, updateData);",
      "    return { data };",
      "  }",
      "",
      "  @HttpCode(HttpStatus.OK)",
      "  @ApiOperation({ summary: 'Remove a ${1:CustomName} by ID' })",
      "  @ApiResponse({",
      "    type: withBaseDataResponse(${1:CustomName}Response),",
      "    status: HttpStatus.OK,",
      "    description: 'Remove a ${1:CustomName} by ID',",
      "  })",
      "  @ApiResponse({",
      "    type: withErrorResponse({ status: HttpStatus.BAD_REQUEST, title: 'BAD_REQUEST' }),",
      "    status: HttpStatus.BAD_REQUEST,",
      "    description: 'When request isn’t correct',",
      "  })",
      "  @ApiBearerAuth('access-token')",
      "  @Delete(':id')",
      "  async removeById(@Param('id', ParseObjectIdPipe) id: string): Promise<{ data: ${1:CustomName}Response }> {",
      "    const data = await this.${1:camelCase}Service.removeById(id);",
      "    return { data };",
      "  }",
      "}",
    ],
    "description": "Create a customizable NestJS controller",
  },
}

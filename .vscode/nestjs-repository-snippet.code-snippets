{
  "NestJS Repository Template": {
    "prefix": "nestjs-repo",
    "body": [
      "import { Model } from 'mongoose';",
      "",
      "import { Injectable } from '@nestjs/common';",
      "import { InjectModel } from '@nestjs/mongoose';",
      "",
      "import { ${1:ModelName} } from '../../schemas';",
      "",
      "@Injectable()",
      "export class ${1:ModelName}Repository {",
      "    constructor(@InjectModel(${1:ModelName}.name) private readonly ${1/(.*)/${1:/downcase}/}Model: Model<${1:ModelName}>) { }",
      "",
      "    findAll() {",
      "        return this.${1/(.*)/${1:/downcase}/}Model.find().exec();",
      "    }",
      "",
      "    findById(id: string) {",
      "        return this.${1/(.*)/${1:/downcase}/}Model.findById(id).exec();",
      "    }",
      "",
      "    async create(${1/(.*)/${1:/downcase}/}: ${1:ModelName}) {",
      "        return await this.${1/(.*)/${1:/downcase}/}Model.create(${1/(.*)/${1:/downcase}/});",
      "    }",
      "",
      "    async updateById(id: string, updateData: Partial<${1:ModelName}>) {",
      "        return await this.${1/(.*)/${1:/downcase}/}Model.findByIdAndUpdate(id, updateData, { new: true }).exec();",
      "    }",
      "",
      "    async removeById(id: string) {",
      "        return await this.${1/(.*)/${1:/downcase}/}Model.findByIdAndDelete(id).exec();",
      "    }",
      "}",
    ],
    "description": "NestJS Repository Template",
  },
}
